# CineCircle frontend — build-time settings (Vite reads VITE_* vars when you run `npm run build` / `npm run dev`).
# All of them are optional: with no .env file the local defaults below are used and the app runs as before.
# For local overrides copy this file to `.env.local` (git-ignored). On Cloudflare Pages set them as
# environment variables of the project. Do NOT put secrets here: VITE_* values end up in the public JS bundle.

# Backend API base URL.
# Local default: /api  (the Vite dev server proxies /api to http://localhost:8080)
# Production:    https://<backend>.onrender.com/api
VITE_API_URL=/api

# CineCircle MCP server, Streamable-HTTP endpoint (path /mcp, see mcp-server/README.md).
# Shown in Settings -> "Use CineCircle with Claude".
# Local default: http://localhost:8090/mcp
# Production:    https://<mcp>.onrender.com/mcp
VITE_MCP_URL=http://localhost:8090/mcp

# Client-side upload limit in MB (image picker check + hint text). Keep in line with the backend IMAGE_MAX_BYTES.
# Local default: 5
# Production:    1
VITE_MAX_IMAGE_MB=5
