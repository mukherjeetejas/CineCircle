# Copy to your shell / IntelliJ run configuration / Render environment. Never commit real values.
# Every variable except JWT_SECRET has a local default, so local development needs no changes.

# ---------------------------------------------------------------- secrets / connections

# TMDB v4 "API Read Access Token" (themoviedb.org -> Settings -> API). Sent as Authorization: Bearer.
# Optional at startup: without it the app boots with a warning, movie endpoints return 502 TMDB_UNAVAILABLE
# and seeding skips posts (retried on the next start while the posts collection is empty).
TMDB_API_TOKEN=your_tmdb_v4_read_access_token

# HMAC secret for signing JWTs. Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional. Defaults to mongodb://localhost:27017/cinecircle (production: your Atlas connection string).
MONGODB_URI=mongodb://localhost:27017/cinecircle

# Optional. Anthropic API key (console.anthropic.com) for AI review summaries and the AI spoiler detector.
# Without it both AI features switch off and everything else works. Deliberately NOT ANTHROPIC_API_KEY.
CINECIRCLE_LLM_API_KEY=

# Optional. Anthropic model id for both AI features (default claude-haiku-5-5).
LLM_MODEL=

# ---------------------------------------------------------------- server / URLs

# Optional. HTTP port (default 8080; Render sets it automatically).
PORT=8080

# Optional. Public base URL of this backend, used for absolute image URLs (default http://localhost:8080).
# Production: https://<backend>.onrender.com
APP_PUBLIC_BASE_URL=http://localhost:8080

# Optional. Allowed frontend origins, comma-separated (default http://localhost:5173).
# Production: https://<project>.pages.dev
APP_CORS_ORIGINS=http://localhost:5173

# Optional. Seed demo data on first start with an empty database (default true; production: false).
APP_SEED=true

# ---------------------------------------------------------------- cost protection

# Optional. Largest accepted image upload in bytes (default 5242880 = 5 MB; production: 1048576 = 1 MB).
IMAGE_MAX_BYTES=5242880

# Optional. Uploads are refused (507 STORAGE_FULL) once stored images reach this many MB (default 300).
IMAGE_STORAGE_LIMIT_MB=300

# Optional. Max Anthropic API calls per UTC day for the whole app (default 150).
LLM_DAILY_CALL_LIMIT=150

# Optional. Rate limits (in memory, per instance). Exceeding one returns 429 RATE_LIMITED.
LIMIT_POSTS_PER_DAY=10
LIMIT_COMMENTS_PER_DAY=50
LIMIT_REGISTER_PER_HOUR=5
LIMIT_LOGIN_PER_MINUTE=10
